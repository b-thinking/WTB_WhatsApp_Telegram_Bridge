[Unit]
Description=WhatsApp Telegram Bridge

[Container]
Image=ghcr.io/b-thinking/${GHCR_TAG}:${GHCR_VERSION}

# Pull policy
# Never pull the image
# Pull=never
# Pull only if the image does not exist locally
Pull=missing
# Pull if newer versions with same tag
# Pull=newer

ContainerName=${GHCR_TAG}

Volume=${DEPLOY_VM_DIR}/${GHCR_TAG}/data:/app/data:Z,U

Environment=LOG_LEVEL=DEBUG
Environment=PHONE_NUMBER=${PHONE_NUMBER}
Environment=TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
# TELEGRAM_POLL_TIMEOUT: Not implemented yet
# Environment=TELEGRAM_POLL_TIMEOUT=60 

# Maximum SHM Memory Size
ShmSize=1g

# Podman stop Timeout: It has to be higher than Telegram Poll Timeout: Default 40s
StopTimeout=60

[Service]
# Service stop Timeout. Has to be higher than pod stop timeout (see StopTimeout)
TimeoutStopSec=70
# Restart=none
Restart=always 
RestartSec=120

[Install]
WantedBy=default.target


